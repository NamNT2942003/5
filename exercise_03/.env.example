# Database dùng chung
DB_HOST=quickbite-db
DB_PORT=5432

# Gateway Service
GATEWAY_SERVER_PORT=8080

# User Service
USER_SERVER_PORT=8081
USER_DB_NAME=quickbite_user_db
USER_DB_USERNAME=user_app
USER_DB_PASSWORD=your_user_password_here
USER_DDL_AUTO=update

# Restaurant Service
RESTAURANT_SERVER_PORT=8082
RESTAURANT_DB_NAME=quickbite_restaurant_db
RESTAURANT_DB_USERNAME=restaurant_app
RESTAURANT_DB_PASSWORD=your_restaurant_password_here
RESTAURANT_DDL_AUTO=update

# Order Service
ORDER_SERVER_PORT=8083
ORDER_DB_NAME=quickbite_order_db
ORDER_DB_USERNAME=order_app
ORDER_DB_PASSWORD=your_order_password_here
ORDER_DDL_AUTO=update

# Notification Service
NOTIFICATION_SERVER_PORT=8084
NOTIFICATION_DB_NAME=notification_app
NOTIFICATION_DB_USERNAME=notification_app
NOTIFICATION_DB_PASSWORD=your_notification_password_here
NOTIFICATION_DDL_AUTO=update
